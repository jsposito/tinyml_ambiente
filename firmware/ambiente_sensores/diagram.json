{
  "version": 1,
  "author": "Juliano",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -20,
      "left": 240,
      "attrs": {
        "temperature": "24",
        "humidity": "50"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": 140,
      "left": 240,
      "attrs": {
        "lux": "500"
      }
    }
  ],
  "connections": [
    ["dht1:VCC", "esp:3V3.1", "red", []],
    ["dht1:GND", "esp:GND.1", "black", []],
    ["dht1:SDA", "esp:5", "green", []],

    ["ldr1:VCC", "esp:3V3.1", "red", []],
    ["ldr1:GND", "esp:GND.2", "black", []],
    ["ldr1:AO", "esp:4", "blue", []],

    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []]
  ],
  "serialMonitor": {
    "display": "terminal",
    "newline": "lf",
    "convertEol": false
  },
  "dependencies": {}
}